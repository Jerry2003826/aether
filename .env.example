# Product configuration targets, not credentials supplied by this pack.
AETHER_MODE=offline
AETHER_BIND_HOST=127.0.0.1
AETHER_TIMEZONE=Australia/Melbourne
AETHER_MODEL_API_KEY=
# Generate per-service auth/database secrets during bootstrap; never use shared demo passwords.
AETHER_DATABASE_URL=
AETHER_TEMPORAL_ADDRESS=
AETHER_ARTIFACT_ROOT=
AETHER_ALLOW_LIVE=false
